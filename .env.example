# CoinNewsWired Environment Variables
# Copy this to .env.local and fill in your values

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense Client ID (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# AdSense Ad Slot IDs (get these from your AdSense account)
NEXT_PUBLIC_ADSENSE_HEADER_SLOT=1234567890
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=1234567891
NEXT_PUBLIC_ADSENSE_IN_ARTICLE_SLOT=1234567892
NEXT_PUBLIC_ADSENSE_FOOTER_SLOT=1234567893

# Google Site Verification (for Search Console)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Newsletter API (optional - for Mailchimp, ConvertKit, etc.)
# MAILCHIMP_API_KEY=your-api-key
# MAILCHIMP_LIST_ID=your-list-id